{
  "name": "youtube-video-extractor",
  "private": false,
  "version": "4.0.0",
  "description": "Universal Video-to-Course, Formal Specification & AI Dataset Compiler — Turns ANY YouTube Channel, Lecture Playlist, or Technical Video into Structured Course Handbooks (MASTER_<CONCEPT>.md), Deterministic Dual-FSM Specs, .jsonl Datasets, and Executable Code via Claude Code",
  "license": "MIT",
  "author": "Christ Yvan <yaochristyvan8@gmail.com> (https://github.com/Christ-yavn)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Christ-yavn/youtube-video-extractor.git"
  },
  "homepage": "https://github.com/Christ-yavn/youtube-video-extractor#readme",
  "bugs": {
    "url": "https://github.com/Christ-yavn/youtube-video-extractor/issues"
  },
  "keywords": [
    "open-source",
    "claude-code",
    "anthropic",
    "youtube-to-course",
    "video-compiler",
    "formal-specification",
    "jsonl-dataset",
    "finite-state-machine",
    "edtech",
    "rag",
    "market-microstructure",
    "quantitative-finance",
    "python",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/utils/pipeline.test.ts src/utils/ictTaxonomy.test.ts src/utils/driveHelpers.test.ts src/utils/domainProfiles.test.ts",
    "ingest:universal": "python scripts/universal_youtube_ingest.py",
    "compile:claude": "python scripts/claude_agent_bridge.py",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
